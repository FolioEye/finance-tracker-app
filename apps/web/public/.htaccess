# SPA fallback for client-side routing (react-router-dom BrowserRouter).
# Without this, a direct request or refresh on any route other than "/"
# (e.g. /login) 404s -- Apache looks for a literal file/directory at that
# path, finds nothing, and never gets a chance to hand it to index.html
# for React Router to handle client-side. This file is copied into
# dist/ unmodified by Vite's public/ convention, so it ships with every
# deploy automatically.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Real files and directories (index.html itself, /assets/*.js, etc.)
  # are served as-is -- only fall through to index.html for paths that
  # don't exist on disk.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Python bytecode / cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Test / coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover

# Allure results and generated reports (FINTRACK-65). Build output, not
# source: CI regenerates these every run and publishes the report to Pages.
# Committing them would also defeat the redaction step in
# scripts/trim_allure_results.py, since the raw results contain tokens and
# traces and this is a public repository.
allure-results/
allure-report/
allure-history/
e2e-results.xml
apps/web/test-results/
apps/web/playwright-report/

# Packaging
*.egg-info/
build/
dist/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Env files with real secrets -- .env.example is fine, real .env never is
.env
.env.local

# Local smoke-test artifacts (e.g. curl -c cookies.txt) -- may contain a
# captured session/refresh token, never commit even if already revoked
cookies.txt

# Project-level SDLC security/performance parameter record -- local-only
# per Mr M's decision (2026-08-04): stays out of the shared remote repo.
docs/security-performance-parameters.md
graphify-out/
vault/

# ─────────────────────────────────────────────────────────────────────────
# SDLC pipeline internals -- this repository is PUBLIC (see ADR-005, which
# depends on that for free-plan environment reviewers).
#
# The agent definitions, the workflow's stage machine and tool allowlist, and
# the signed audit envelopes are the pipeline's own material, not this
# application's source. The live copies belong in the private `gforce` repo.
# Nothing here reads any of them: pytest.ini collects only
# tests/unit tests/security tests/integration, ci-cd.yml never mentions them,
# and apps/api/Dockerfile's build context is apps/api/ alone -- so the copies
# that were committed here were inert duplicates, published for no benefit.
#
# Same intent as the docs/security-performance-parameters.md line above.
# Raised under FINTRACK-65.
# ─────────────────────────────────────────────────────────────────────────
*_agent.json
finance-app_workflow.json
Fintrack/audit/
